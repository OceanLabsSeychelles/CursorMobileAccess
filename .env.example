# Copy to .env in repo root (gitignored). Bridge loads this file on start.
#
# Generate a strong token, e.g. PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])

BRIDGE_AUTH_TOKEN=change-me-to-a-long-random-secret
# Tailscale IP or 127.0.0.1 for local-only
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
CDP_URL=http://127.0.0.1:9222

# Self-hosted ntfy (optional — see infra/ntfy/)
NTFY_URL=http://127.0.0.1:2586
NTFY_TOPIC=cursor-pick-a-random-topic-name

# URL opened when tapping an ntfy notification (phone-reachable web UI)
# Defaults to http://$BRIDGE_HOST:$BRIDGE_PORT when BRIDGE_HOST is not localhost
# BRIDGE_PUBLIC_URL=http://100.x.x.x:8787
